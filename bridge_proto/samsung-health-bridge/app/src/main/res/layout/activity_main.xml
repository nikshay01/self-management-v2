<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Samsung Health Bridge"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Status Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Samsung Health: Checking…"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <!-- Permissions Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Permissions"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvPermSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Steps: —"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvPermHeartRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Heart Rate: —"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvPermSleep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sleep: —"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvPermExercise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Exercise: —"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- Request Permissions Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRequestPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Request Permissions"
            android:layout_marginBottom="8dp" />

        <!-- Sync Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Last Sync"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvLastSync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Never"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- Sync Now Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSyncNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sync Now"
            android:layout_marginBottom="16dp" />

        <!-- Data Summary Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data Summary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvDataSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No data retrieved yet."
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="16dp" />

        <!-- Sync Result Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Last Result"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvSyncResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="16dp" />

        <!-- Error Display -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="#D32F2F"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
