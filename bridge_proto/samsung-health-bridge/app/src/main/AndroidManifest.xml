<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network permissions for backend API communication -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The user must enable Usage Access in Android Settings before screen-time reads work. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <!-- Package visibility for Samsung Health (required on Android 11+ / API 30+) -->
    <queries>
        <package android:name="com.sec.android.app.shealth" />
        <!-- Allow app labels to be resolved without requesting visibility of every installed package. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SamsungHealthBridge"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.RawJsonActivity" android:exported="false" android:label="Raw data" />
    </application>

</manifest>
